{
    "extends": "@open-urbis/typescript-config/base.json",
    "compilerOptions": {
        "module": "esnext",
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "lib": [
            "es2018"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}