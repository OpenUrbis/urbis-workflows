{
    "name": "@open-urbis/types",
    "version": "1.0.0",
    "description": "Shared TypeScript types for Urbis Workflows applications.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsc --watch",
        "build": "tsc",
        "clean": "rm -rf dist",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@types/json-schema": "7.0.15",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "reflect-metadata": "0.2.2"
    },
    "peerDependencies": {
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "reflect-metadata": "0.2.2"
    },
    "devDependencies": {
        "typescript": "^5.3.3"
    },
    "publishConfig": {
        "access": "public"
    }
}