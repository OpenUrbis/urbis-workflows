  },
  "peerDependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
