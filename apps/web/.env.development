VITE_PUBLIC_MAPBOX_ACCESS_TOKEN=

# @open-urbis/map HTTP API origin (maps/config, intersections, …). vite.config injects this as import.meta.env.VITE_API_URL for that package only.

VITE_OPEN_URBIS_MAP_HTTP_BASE=https://api.mapa.urbis.prefeitura.sp.gov.br

VITE_BACK_END_API=http://localhost:4000
VITE_BACK_END_PDF=https://api.mapa.urbis.prefeitura.sp.gov.br
VITE_BACK_END_FILES=https://api.mapa.urbis.prefeitura.sp.gov.br
VITE_MAP=https://mapa.urbis.prefeitura.sp.gov.br
VITE_ENV=development
VITE_VERSION=1.4.17

# OIDC Configuration (Contas)
VITE_OIDC_AUTHORITY=http://localhost:3000/auth/oidc
VITE_OIDC_CLIENT_ID=94a86322-269e-44df-803a-534c0382215d
VITE_OIDC_REDIRECT_URI=http://localhost:5176/callback
VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:5176/silent-renew.html

# Contas (accounts app) URL for profile redirect
VITE_ACCOUNTS_URL=http://localhost:4200
