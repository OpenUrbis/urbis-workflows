# ==============================================================================
# URBIS WORKFLOWS (VIABILIZA) - FRONTEND WEB (.env.example)
# ==============================================================================

# Token público do Mapbox / MapLibre (se aplicável para tiles vetoriais)
VITE_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token_here

# Origem da API HTTP do Urbis Map (layer schemas, interseções)
VITE_OPEN_URBIS_MAP_HTTP_BASE=http://localhost:3000

# Backend do Viabiliza (Workflows API)
VITE_BACK_END_API=http://localhost:4000
VITE_BACK_END_PDF=http://localhost:4000
VITE_BACK_END_FILES=http://localhost:3000
VITE_MAP=http://localhost:5173
VITE_ENV=development
VITE_VERSION=1.0.0

# Configurações de Autenticação OIDC (Urbis Accounts)
VITE_OIDC_AUTHORITY=http://localhost:3000/auth/oidc
VITE_OIDC_CLIENT_ID=94a86322-269e-44df-803a-534c0382215d
VITE_OIDC_REDIRECT_URI=http://localhost:5176/callback
VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:5176/silent-renew.html

# URL do portal de contas (Accounts)
VITE_ACCOUNTS_URL=http://localhost:4200
